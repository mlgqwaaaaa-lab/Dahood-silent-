-- ===== LOGIC =====
local function getChar(plr)
    return plr and plr.Character
end

local function isKO(plr)
    local char = getChar(plr)
    if not char then return true end
    local be = char:FindFirstChild("BodyEffects")
    if be then
        local ko = be:FindFirstChild("K.O")
        if ko and ko.Value then return true end
    end
    if char:FindFirstChild("GRABBING_CONSTRAINT") then return true end
    return false
end

local function partPos(plr)
    local char = getChar(plr)
    if not char then return nil end
    local p = char:FindFirstChild(CFG.TargetPart)
        or char:FindFirstChild("HumanoidRootPart")
    return p and p.Position, p
end

local function validTarget(plr)
    if plr == LP then return false end
    local char = getChar(plr)
    if not char then return false end
    local h = char:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return false end
    if CFG.TeamCheck and plr.Team == LP.Team then return false end
    if isKO(plr) then return false end
    return true
end

local function closest()
    local best, bestD = nil, math.huge
    local center = Vector2.new(Cam.ViewportSize.X/2, Cam.ViewportSize.Y/2)
    for _, plr in ipairs(Players:GetPlayers()) do
        if validTarget(plr) then
            local pos, part = partPos(plr)
            if pos then
                local sp, on = Cam:WorldToViewportPoint(pos)
                if on then
                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if d <= CFG.FOV/2 and d < bestD then
                        bestD = d
                        best = plr
                    end
                end
            end
        end
    end
    return best
end

-- Silent Aim hook
local __index
__index = hookmetamethod(game, "__index", function(t, k)
    if t:IsA("Mouse") and (k == "Hit" or k == "Target") and CFG.SilentAim then
        local target = closest()
        if target then
            local pos, part = partPos(target)
            if part then
                local hit = part.CFrame + (part.Velocity * CFG.Prediction)
                return (k == "Hit" and hit or part)
            end
        end
    end
    return __index(t, k)
end)

-- Camlock + Aimlock loop
RunService:BindToRenderStep("MissDiorCamlock", 0, function()
    local active = CFG.Camlock
    if CFG.CamlockKeybindEnabled then
        active = active and UserInputService:IsKeyDown(CFG.CamlockKey)
    end
    if active then
        local target = closest()
        if target then
            local pos, part = partPos(target)
            if part then
                local hit = part.CFrame + (part.Velocity * CFG.Prediction)
                Cam.CFrame = CFrame.lookAt(Cam.CFrame.Position, hit.Position)
            end
        end
    end
end)

-- Slider drags
local draggingF, draggingP = false, false
fovSlider.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then draggingF = true end
end)
predSlider.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then draggingP = true end
end)
UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        draggingF, draggingP = false, false
    end
end)
UserInputService.InputChanged:Connect(function(i)
    if i.UserInputType ~= Enum.UserInputType.MouseMovement and i.UserInputType ~= Enum.UserInputType.Touch then return end
    local mp = UserInputService:GetMouseLocation()
    if draggingF then
        local rel = math.clamp((mp.X - fovSlider.AbsolutePosition.X)/fovSlider.AbsoluteSize.X, 0, 1)
        CFG.FOV = math.floor(40 + rel*(400-40))
        fovFill.Size = UDim2.new(rel, 0, 1, 0)
        fovLbl.Text = "FOV: " .. CFG.FOV
        Circle.Size = UDim2.new(0, CFG.FOV, 0, CFG.FOV)
        Circle.Position = UDim2.new(0.5, -CFG.FOV/2, 0.5, -CFG.FOV/2)
    end
    if draggingP then
        local rel = math.clamp((mp.X - predSlider.AbsolutePosition.X)/predSlider.AbsoluteSize.X, 0, 1)
        CFG.Prediction = math.floor(rel * 100) / 100
        predFill.Size = UDim2.new(rel, 0, 1, 0)
        predLbl.Text = "Prediction: " .. CFG.Prediction
    end
end)

-- Keybind
